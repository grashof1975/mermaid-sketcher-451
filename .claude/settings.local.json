{
  "permissions": {
    "allow": [
      "Bash(git clean:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(git config:*)",
      "Bash(git remote set-url:*)",
      "Bash(git rm:*)",
      "Bash(git commit:*)",
      "Bash(dir:*)",
      "Bash(git show-branch:*)",
      "Bash(code database-fixes/APPLY_004_SHARING_SYSTEM_PENDING.sql)",
      "Bash(ren:*)",
      "Bash(npm run dev:*)",
      "Bash(github-sync/resume-screenshot-hook.bat)",
      "Bash(move:*)",
      "Bash(echo:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git stash:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '📷 Auto-monitor SCREENSHOT attivo per questa sessione'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"if (Test-Path 'github-sync\\SCREENSHOT\\*.jpg') { Get-ChildItem 'github-sync\\SCREENSHOT\\*.jpg' | ForEach-Object { Write-Host '📷 Nuovo screenshot rilevato:' $_.Name } }\""
          }
        ]
      }
    ]
  }
}