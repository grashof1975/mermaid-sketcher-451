      "Bash(npx supabase db reset:*)",
      "Bash(del:*)",
      "Bash(call dump-schema.bat)",
      "Bash(./dump-schema.bat)",
      "Bash(powershell:*)",
      "Read(C:\\CLAUDEcode2025/**)",
      "Bash(sed:*)",
      "Bash(start http://localhost:8083)",
